{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With, mcp-session-id" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://rodayupwqttjbzwuytxl.supabase.co https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp?ronic_path=%2Fmcp" },
    { "source": "/authorize", "destination": "/api/mcp?ronic_path=%2Fauthorize" },
    { "source": "/token", "destination": "/api/mcp?ronic_path=%2Ftoken" },
    { "source": "/register", "destination": "/api/mcp?ronic_path=%2Fregister" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp?ronic_path=%2F.well-known%2Foauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/mcp?ronic_path=%2F.well-known%2Foauth-protected-resource%2Fmcp" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp?ronic_path=%2F.well-known%2Foauth-authorization-server" },
    { "source": "/.well-known/oauth-authorization-server/mcp", "destination": "/api/mcp?ronic_path=%2F.well-known%2Foauth-authorization-server%2Fmcp" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/mcp?ronic_path=%2F.well-known%2Fopenid-configuration" },
    { "source": "/auth/bounce", "destination": "/api/auth/bounce" }
  ]
}
