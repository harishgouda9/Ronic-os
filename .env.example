# Copy to .env.local (frontend) and CI env for release builds.
# Leave a value empty to keep that service off. The anon key is public.
# Do not put the Supabase service role, a Stripe secret, an OpenRouter key,
# or the Ed25519 PRIVATE signing key in any file that ships with the desktop.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# HTTPS endpoint that starts a Stripe Checkout session and returns { "url": "https://checkout.stripe.com/..." }.
VITE_STORE_CHECKOUT_URL=

# --- Cloud control plane (backend-auth-revenue blueprint) -------------------
# Supabase Edge Function that signs the 7-day Ed25519 lease.
# https://<project>.supabase.co/functions/v1/license-lease
VITE_LEASE_URL=
# Vercel endpoint that creates Stripe/Razorpay checkouts (backend/api/v1/checkout).
VITE_CHECKOUT_API=
# PKCE bounce page: system browser -> this URL -> ronic://auth/callback?code=…
VITE_AUTH_BOUNCE_URL=https://ronic.os/auth/bounce

# Compile-time (Tauri release build only): raw 32-byte Ed25519 public key as
# base64. Generate the pair with:  cd backend && npm run keys
# Without it the desktop runs in unsigned dev mode (license shown, not enforced).
RONIC_ED25519_PUBLIC_KEY=
