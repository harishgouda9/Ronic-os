# Copy to .env.local. Leave a value empty to keep that service off.
# The anon key is public. Do not put the Supabase service role or a Stripe secret here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# HTTPS endpoint that starts a Stripe Checkout session and returns { "url": "https://checkout.stripe.com/..." }.
VITE_STORE_CHECKOUT_URL=
