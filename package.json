{
  "name": "ronicos",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test scripts/desktop.test.mjs scripts/miniDriveScripts.test.mjs scripts/messagingGateway.test.mjs scripts/chiefDelegation.test.mjs scripts/marketplaceAuth.test.mjs scripts/memoryBackup.test.mjs scripts/walletRealRails.test.mjs && node --experimental-strip-types --test scripts/updates.test.mjs",
    "test:rust": "node scripts/rust-tests.mjs",
    "desktop": "node ./scripts/desktop.mjs dev",
    "desktop:build": "node ./scripts/desktop.mjs build",
    "desktop:build:binary": "node ./scripts/desktop.mjs build --no-bundle",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/api": "^2.7.0",
    "@xyflow/react": "^12.8.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.544.0",
    "mediabunny": "^1.62.1",
    "posthog-js": "^1.438.12",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.7.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
